{
  "name": "crucible",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "verify:live": "node scripts/verify-live.mjs",
    "journey": "node scripts/journey.mjs",
    "browser": "node scripts/browser.mjs",
    "verify:db": "node scripts/db-smoke.mjs",
    "verify:bundle": "node scripts/bundle-check.mjs",
    "audit:secrets": "node scripts/security-audit.mjs",
    "publish:blog": "node scripts/publish-blog.mjs",
    "gate": "npm run typecheck && npm run lint && npm run test && npm run build && npm run audit:secrets && npm run verify:db && npm run verify:bundle"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@neondatabase/serverless": "^1.2.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
